# Backend environment variables for local and Hostinger deployment.
MYSQL_DATABASE=hospital_management
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Generate a different random value for every environment. Never commit the real value.
JWT_SECRET=replace_with_a_long_random_secret

# First administrator created when the server starts.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_before_deployment

PORT=5000
NODE_ENV=development
