# Backend environment variables for MySQL deployment
# You may also use DB_NAME, DB_USER, DB_PASSWORD, and DB_HOST instead of the MYSQL_* names.
MYSQL_DATABASE=hospital_management
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
JWT_SECRET=your_jwt_secret_here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword123
NODE_ENV=development
